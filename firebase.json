{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", "firestore.indexes.json",
      "**/.*", "**/node_modules/**",
      "functions/**", "tools/**", "README.md"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-southeast1" } }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ] },
      { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "content/**", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(js|css)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
      { "source": "assets/data/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
      { "source": "images/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] },
      { "source": "admin/**", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-cache" } ] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs20", "ignore": ["node_modules", ".git", "*.log"] }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
